# Modelo de configuração. Copie para ".env" e preencha.
# O .env fica na raiz do projeto ou dentro de producao/ (no computador
# do LabVIEW, onde só a pasta producao/ é instalada). NUNCA versione o .env.

# Chave da API do ERP, enviada pela equipe de TI (obrigatória)
ERP_API_KEY=

# URL da consulta de ordem (obrigatória)
ERP_API_URL=https://www.sistemasbaumer.com.br/api/OrdemProducao/{numero_da_ordem}

# Tempo máximo de espera da API, em segundos (opcional, padrão: 10)
ERP_API_TIMEOUT_S=10
