# ------------------------------------------------------------
# YOLO / Ultralytics
# ------------------------------------------------------------
# Cache binário gerado a cada treino/validação
*.cache
# Peso-base que o Ultralytics baixa ao rodar da raiz; o oficial do
# projeto fica em final/scripts_comuns/yolov8n.pt
/yolov8n.pt

# ------------------------------------------------------------
# Etapa final
# ------------------------------------------------------------
# Dataset derivado, regenerável com organizar_dataset.py
final/dataset_yolo/

# Saída visual de cada treino. Ficam versionados só weights/best.pt,
# results.csv/png, confusion_matrix.png e args.yaml
final/modelos/*/*/train_batch*.jpg
final/modelos/*/*/val_batch*.jpg
final/modelos/*/*/labels.jpg
final/modelos/*/*/weights/last.pt

# Scratch de teste manual
final/scripts_comuns/teste.png
final/scripts_comuns/teste_inspecionado.png

# ------------------------------------------------------------
# Etapa de produção
# ------------------------------------------------------------
# Dados gerados em tempo de execução
producao/registros/
producao/relatorios/
# Pacote de deploy, redundante com a pasta producao/
producao.zip
